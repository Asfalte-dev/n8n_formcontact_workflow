    {
      "parameters": {
        "jsCode": "// Récupère la date de soumission\nconst submittedAt = $('Formulaire contact').item.json.submittedAt;\nlet dt = DateTime.fromISO(submittedAt);\n\nlet addedDays = 0;\nwhile (addedDays < 7) {\n  dt = dt.plus({ days: 1 });\n  // Si ce n'est ni samedi (6) ni dimanche (7), on incrémente\n  if (dt.weekday <= 5) {\n    addedDays++;\n  }\n}\n\n// Retourne la nouvelle date formatée\nreturn [{ json: { dateRecontact: dt.toFormat('dd-MM-yyyy') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
